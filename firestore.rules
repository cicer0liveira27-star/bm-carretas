rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin principal (fixo) + admins cadastrados pelo painel (coleção "admins", id = e-mail)
    function isMaster() {
      return request.auth != null && request.auth.token.email in ['cicerosilvadevtec@gmail.com'];
    }
    function isAdmin() {
      return isMaster() || (request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // Lista de administradores: cada um lê o próprio; só admin altera
    match /admins/{email} {
      allow read: if request.auth != null && (request.auth.token.email.lower() == email || isAdmin());
      allow write: if isAdmin();
    }

    // Perfil de cada pessoa
    match /users/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Orçamentos: qualquer visitante envia; cliente vê os dele; admin vê e altera todos
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['protocolo','nome','whats'])
                    && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Preços e fotos: todos leem, só admin altera
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }
    match /fotos/{id}  { allow read: if true; allow write: if isAdmin(); }

    // Financeiro (receitas e despesas): só admin
    match /lancamentos/{id} { allow read, write: if isAdmin(); }
  }
}
